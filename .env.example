# Copy this file to .env and fill in real values. .env is gitignored.
# EXPO_PUBLIC_* variables are inlined into the app at build time by Expo —
# restart the dev server after editing. Note these end up in the built binary,
# so they are not truly secret; the real protection is enforced server-side.

# Your deployed server's base URL (HTTPS in production).
EXPO_PUBLIC_SERVER_URL=https://your-server.example.com

# Must match REGISTRATION_SECRET in your server's environment. Authorizes the
# one-time /register call that issues a per-device token.
EXPO_PUBLIC_REGISTRATION_SECRET=your-registration-secret-here
