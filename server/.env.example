# REQUIRED in production (server refuses to start without them when
# NODE_ENV=production): TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID,
# TWILIO_API_KEY_SECRET, TWILIO_PHONE_NUMBER, SERVER_URL, REGISTRATION_SECRET.
#
# Auth uses a Twilio API Key (Console → Account → API keys & tokens → Standard
# key), not the account Auth Token — revocable, least-privilege, production-grade.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public URL of this server (used to build MMS media links)
# Local dev with physical device: use ngrok → https://xxxx.ngrok.io
# Production: your deployed URL → https://makeithome.yourapp.com
SERVER_URL=https://your-server-url.com

PORT=3000

# Comma-separated list of allowed browser origins, e.g.:
#   https://makeithome.app,https://admin.makeithome.app
# Leave empty in local dev. The mobile app is always allowed (no Origin header).
ALLOWED_ORIGINS=

# Secret used only during device registration (POST /register).
# The app presents this once to receive a per-device token.
# Set this to any long random string before deploying.
REGISTRATION_SECRET=

# Redis connection URL — REQUIRED in production, optional in local dev.
# If set, check-in timers and live sessions survive server restarts.
# On Railway: add the Redis plugin and reference it, e.g. REDIS_URL=${{Redis.REDIS_URL}}
# If not set: falls back to in-memory storage (dev only). In production with
# NODE_ENV=production and no REDIS_URL, /health returns 503 and boot logs a
# loud warning, because check-in timers would not survive a redeploy.
REDIS_URL=

# NODE_ENV=production enables the production safety checks above.
NODE_ENV=
